# suggestions from copilot
# create text file with 1 accession per line

accessions = [line.strip() for line in open("accessions.txt") if line.strip()]

# at top of snakefile
plugins:
    - biopython.Fetch

# define the rule
rule fetch_sequences:
    output:
        "sequences/{accession}.fasta"
    params:
        db="nucleotide",  # or "protein", depending on your accessions
        rettype="fasta",
        retmode="text"
    plugin:
        "biopython.Fetch"
    resources:
        accession=lambda wildcards: wildcards.accession

# define workflow targets
rule all:
    input:
        expand("sequences/{accession}.fasta", accession=accessions)

# may need to set api key to avoid rate limits
export NCBI_API_KEY=your_api_key_here



