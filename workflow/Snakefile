# ==================================================
# NemaTree:
# Root-Knot Nematode rRNA phylogenetic analysis
# ==================================================


# control workflow by editing the config file
configfile: "config/config.yaml"


include: "rules/common.smk"


# samples to add to reference alignment are defined in config file
# SAMPLES is defined in common.smk and can be used below (and globally)
# The locus, reference alignment, and rooting method are defined in config

REF_ALIGNMENT = get_reference(config)
SUBST_MODEL = get_substitution_model(config)

# IQtree support value settings
# BOOTSTRAP_FLAG = get_bootstrap_flag(config)
SUPPORT_FLAG_STRING = get_support_flags(config)

config["rooting"] = get_rooting(config)

# output formats for trees, default is html (also png, pdf, svg)
TOYTREE_FORMATS = config.get("tree_formats", ["html"])
# define the name of all final trees, because it is now used in several places
TOYTREE_PLOTS = expand(
    "results/reporting/toytree/{sample}_mafft_cialign_cleaned_iqtree.{ext}",
    sample=SAMPLES,
    ext=TOYTREE_FORMATS,
)

#  ------------
# TARGET RULE
# -------------
rule all:
    input:
        expand("results/samples/{sample}_validated.fas", sample=SAMPLES),
        expand("results/reporting/seqkit/{sample}_seqkit_report.md", sample=SAMPLES),
        expand("results/mafft/{sample}_mafft.fas", sample=SAMPLES),
        expand("results/reporting/mafft/{sample}_checkaddseqs_log.txt", sample=SAMPLES),
        expand("results/cialign/{sample}_mafft_cialign_cleaned.fasta", sample=SAMPLES),
        expand(
            "results/reporting/plots/{sample}_length_histogram.html", sample=SAMPLES
        )
        if config.get("generate_seq_plots", False)
        else [],
        expand(
            "results/reporting/plots/{sample}_alnseqlength_histogram.html",
            sample=SAMPLES,
        )
        if config.get("generate_seq_plots", False)
        else [],
        expand("results/reporting/amas/{sample}_mafft_cialign_amas.tsv", sample=SAMPLES),
        expand(
            "results/reporting/cialign/{sample}_mafft_cialign_output.png",
            sample=SAMPLES,
        )
        if config.get("generate_seq_plots", False)
        else [],
        expand(
            "results/iqtree/{sample}_mafft_cialign_cleaned_iqtree.treefile",
            sample=SAMPLES,
        ),
        TOYTREE_PLOTS,
        "results/reporting/jobs_detail.csv",
        "results/reporting/summary_by_rule.csv",

        # expand(
        #     "results/reporting/toytree/{sample}_mafft_cialign_cleaned_iqtree.{ext}",
        #     sample=SAMPLES,
        #     ext=TOYTREE_FORMATS,
        # ),


